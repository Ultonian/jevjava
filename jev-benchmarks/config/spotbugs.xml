<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <!-- Only annotation-processor output, never handwritten benchmark code. -->
  <Match>
    <Class name="~net\.codefinch\.jev\.benchmarks\.components\.jmh_generated\..*"/>
  </Match>
  <!-- Optional Linux kernel metadata has fixed absolute paths, checked for readability.
       Limit this exception to that method; all other handwritten checks remain enabled. -->
  <Match>
    <Class name="net.codefinch.jev.benchmarks.reporting.RunMetadata"/>
    <Method name="cgroupLimits"/>
    <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
  </Match>
  <!-- JFR reads event payload fields through JVM instrumentation, not a Java field read. -->
  <Match>
    <Class name="net.codefinch.jev.benchmarks.diagnostics.RecordingProbe$ProbeEvent"/>
    <Field name="value"/>
    <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>
</FindBugsFilter>
