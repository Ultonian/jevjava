# Copy to .env (git-ignored) and fill in; then, before a live run:
#   set -a; . ./.env; set +a
TYPESAFE_API_KEY=
# Opt-in probes against the real API (LiveApiTest, LiveExamplesTest); leave unset for the gate
JEV_RUN_LIVE_TESTS=1
# Optional overrides
#TYPESAFE_BASE_URL=https://api.typesafe.ai
#TYPESAFE_DEFAULT_MODEL=jev-latest
#TYPESAFE_LOG_LEVEL=info
